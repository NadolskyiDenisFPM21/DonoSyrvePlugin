<?xml version="1.0"?>
<configuration>
    <configSections>
        <sectionGroup name="applicationSettings" type="System.Configuration.ApplicationSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
            <section name="Resto.Front.Api.SamplePlugin.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false"/>
        </sectionGroup>
    </configSections>
	<appSettings>
		<add key="TelegramBotToken" value="8632482154:AAEh8TErroCz-cIH_VnShwxj-vQ_2jkbUmQ" />
		<add key="TelegramChatId" value="1096767306" />
		<add key="DonoAppURL" value="https://api.dono.pizza/api/webhooks/syrve" />
		<add key="DonoAppToken" value="09fe2903-a7bb-4d96-a000-7ff1e672caff" />
		<add key="DonoAppTTStatusURL" value="https://api.dono.pizza/api/webhooks/terminal-heartbeat" />
		<!-- Бегунок с QR при закрытии заказа "Без выручки": true — включён, false или нет ключа — выключен -->
		<add key="RunnerEnabled" value="false" />
		<!-- Имя принтера как в "Устройства и принтеры"; пусто — принтер по умолчанию -->
		<add key="RunnerPrinterName" value="POS-80" />
		<!-- Разделитель кодов в QR: LF, CR или CRLF -->
		<add key="RunnerQrSeparator" value="LF" />
		<!-- Размер клетки QR в мм (0.5 = 4 точки на 203 dpi). Меньше — компактнее QR, но хуже читается -->
		<add key="RunnerQrModuleMm" value="0.5" />
	</appSettings>
    <applicationSettings>
        <Resto.Front.Api.SamplePlugin.Properties.Settings>
            <setting name="ExtendBillCheque" serializeAs="String">
                <value>True</value>
            </setting>
        </Resto.Front.Api.SamplePlugin.Properties.Settings>
    </applicationSettings>
    <runtime>
        <!-- Разрешает загрузку сборок с меткой "из интернета" (Zone.Identifier) без Unblock-File -->
        <loadFromRemoteSources enabled="true"/>
    </runtime>
<startup><supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2"/></startup></configuration>
